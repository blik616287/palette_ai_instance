# Single source of truth for toolchain versions.
# Both the Makefile (via `include .versions`) and the Dockerfile (via
# --build-arg, driven by the Makefile) read from here. Bumping a version
# is a one-line change.
#
#   ?= keeps existing env var values, so any of these can still be
#   overridden on the CLI (e.g. `GO_VERSION=1.24.0 make ci`) or in CI
#   without editing the file.

GO_VERSION             ?= 1.25.10
ALPINE_VERSION         ?= 3.22
GOLANGCI_LINT_VERSION  ?= v1.64.8

# Closes M4 — see reviews/2026-05-15T195833Z-review.md#m4.
# Digest pin for public.ecr.aws/docker/library/golang:<GO_VERSION>-alpine<ALPINE_VERSION>.
# Refresh in lockstep with GO_VERSION/ALPINE_VERSION above. Look up via:
#   docker buildx imagetools inspect public.ecr.aws/docker/library/golang:<tag>
GO_IMAGE_DIGEST        ?= sha256:26b4d7113039cd51356bd7930ecafd1031d2975dc3b6940ec8ed09457e17cf95
